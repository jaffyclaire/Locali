rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getMerchant(merchantId) {
      return get(/databases/$(database)/documents/merchants/$(merchantId)).data;
    }

    function isMerchantOwner(merchantId) {
      return isAuthenticated() && getMerchant(merchantId).ownerId == request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isNotDisabled() {
      return isAuthenticated() && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled;
    }

    // --- Users Collection ---
    // A user can only read and write their own document
    // Admins can read all users and update roles/status
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    // --- Interests Collection (Taxonomy) ---
    // Publicly readable by all clients; read-only for client apps
    match /interests/{interestId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Merchants Collection ---
    // Publicly readable; only writable by the merchant's owner
    // Admins can update verification and suspension status
    match /merchants/{merchantId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid || isAdmin();
      allow delete: if false;

      // Merchant Photos subcollection
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isMerchantOwner(merchantId);
      }

      // Merchant Holiday Closures subcollection
      match /holidayClosures/{closureId} {
        allow read: if true;
        allow write: if isMerchantOwner(merchantId);
      }

      // Merchant Reviews subcollection
      // Publicly readable; user can only create/update/delete their own review
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // --- Saved Merchants (per user) ---
    // Only readable and writable by the owning user
    match /savedMerchants/{uid} {
      allow read, write: if isOwner(uid);

      match /items/{merchantId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- Notifications (per user) ---
    // Only readable and writable by the owning user
    match /notifications/{uid} {
      allow read, write: if isOwner(uid);

      match /items/{notificationId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- Flag Reports ---
    // Any authenticated user can create a report for themselves.
    // Only the original reporter or the merchant owner can read it.
    // Merchant owners and admins can update/resolve reports.
    match /flagReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        isMerchantOwner(resource.data.merchantId) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isMerchantOwner(resource.data.merchantId) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // --- Merchant Views & Direction Taps ---
    // Any client (authenticated or unauthenticated) can create telemetry.
    // Only the merchant owner can read telemetry for their business.
    match /merchantViews/{viewId} {
      allow create: if true;
      allow read: if isAuthenticated() && isMerchantOwner(resource.data.merchantId);
      allow update, delete: if false;
    }

    match /directionTaps/{tapId} {
      allow create: if true;
      allow read: if isAuthenticated() && isMerchantOwner(resource.data.merchantId);
      allow update, delete: if false;
    }

    // --- Check-Ins ---
    match /checkIns/{checkInId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // --- Sponsored Cards ---
    // Publicly readable active promotional cards; writable by admin or merchant owner
    match /sponsoredCards/{cardId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        resource == null || resource.data.merchantId == null || isMerchantOwner(resource.data.merchantId)
      );
    }
  }
}
