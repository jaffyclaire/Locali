# Firebase Configuration
# Copy this file to `.env` and fill in the values from the Firebase Console:
#   Project Settings > General > Your apps > Web app > SDK setup and configuration > Config
#
# Do NOT commit the real `.env` (it is gitignored). Commit this `.env.example` instead.
#
# NOTE: EXPO_PUBLIC_* values are inlined into the client bundle at build time and are
# therefore public to anyone who loads the app. The API key is not a secret in a mobile
# app -- protect it with API key restrictions in Google Cloud Console, not with gitignore.

EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""
